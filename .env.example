# ==========================================
# Watech Multi-Sector Platform Environment Variables
# ==========================================

# 1. Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="watech-platform.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="watech-platform"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="watech-platform.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456789"

# 2. Meta WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="EAAxxxxxx...your_permanent_system_user_token"
WHATSAPP_VERIFY_TOKEN="watech_secure_verify_token_2026"
PARTNER_ALERT_PHONE_NUMBER="923001234567"

# 3. Self-Hosted n8n Automation
N8N_WHATSAPP_WEBHOOK_URL="https://watech-n8n-automation.onrender.com/webhook/watech-whatsapp-webhook-01"
NEXT_PUBLIC_N8N_WEBHOOK_URL="https://watech-n8n-automation.onrender.com/webhook/inquiry-lead-capture"
