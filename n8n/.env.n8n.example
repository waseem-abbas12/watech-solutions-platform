# ==============================================================================
# WATECH MULTI-SECTOR PLATFORM — N8N ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. N8N INSTANCE CORE CONFIGURATION (RENDER.COM)
# ------------------------------------------------------------------------------
NODE_ENV=production
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=watech-n8n-automation.onrender.com
WEBHOOK_URL=https://watech-n8n-automation.onrender.com/
N8N_ENCRYPTION_KEY=replace_with_a_32_character_random_hex_string
N8N_COMMUNITY_PACKAGES_ENABLED=true

# Execution History Pruning (Prevents DB from bloating on free tier)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168 # 7 days in hours
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (AUTOMATICALLY PROVIDED BY RENDER BLUEPRINT)
# ------------------------------------------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=dpg-xxxxxx.frankfurt-postgres.render.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=your_render_postgres_password

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API (1,000 FREE CONVERSATIONS / MONTH)
# Get from: https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAAxxxxxx_permanent_system_user_access_token
WHATSAPP_VERIFY_TOKEN=watech_secure_verify_token_2026

# Default Support / Operations Alert Mobile (with country code e.g. 923001234567)
PARTNER_ALERT_PHONE_NUMBER=923270831470

# ------------------------------------------------------------------------------
# 4. FIREBASE CLOUD FIRESTORE INTEGRATION
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=watech-solutions
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@watech-solutions.iam.gserviceaccount.com
# Format: standard single-line with \n for private key or configure n8n credential directly
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. OPENAI API CONFIGURATION (GPT-4o-mini)
# Get from: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. GMAIL & GOOGLE CALENDAR
# ------------------------------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=admin@watechsolutions.com
GMAIL_USER=notifications@watechsolutions.com
# For SMTP / Direct sending: Use Google App Password from https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GOOGLE_CALENDAR_ID=primary
